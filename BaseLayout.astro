:root {
  --ink: #0f172a;
  --navy: #123458;
  --paper: #f8fafc;
  --white: #ffffff;
  --muted: #64748b;
  --line: #dbe4ee;
  --gold: #eab308;
  --soft-blue: #eaf1f7;
  --max: 1240px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  line-height: 1.6;
}
a { color: inherit; text-decoration: none; }
button, a { -webkit-tap-highlight-color: transparent; }
::selection { background: #dbeafe; color: var(--navy); }

.page-shell { width: min(calc(100% - 40px), var(--max)); margin: 0 auto; }
.site-header {
  min-height: 92px; display: flex; align-items: center; justify-content: space-between;
  border-bottom: 1px solid var(--line); position: relative; z-index: 10;
}
.brand { font-size: 1.15rem; font-weight: 760; letter-spacing: -0.03em; }
.brand span { color: var(--gold); }
nav { display: flex; align-items: center; gap: 28px; font-size: .91rem; color: #334155; }
nav a { transition: color .2s ease; }
nav a:hover { color: var(--navy); }
.nav-cta { border: 1px solid var(--ink); border-radius: 999px; padding: 9px 16px; }

.hero { min-height: 760px; display: grid; grid-template-columns: 1.28fr .72fr; gap: 8vw; align-items: center; padding: 80px 0 100px; }
.kicker, .eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: .73rem; font-weight: 750; color: var(--navy); }
.hero h1 { font-size: clamp(3.7rem, 7vw, 7.8rem); line-height: .94; letter-spacing: -.07em; margin: 24px 0 32px; max-width: 900px; }
.hero h1 em { font-family: Georgia, 'Times New Roman', serif; font-weight: 400; color: var(--navy); }
.hero-intro { font-size: clamp(1.08rem, 1.4vw, 1.34rem); color: #475569; max-width: 720px; }
.hero-actions { display: flex; gap: 14px; margin: 38px 0 32px; flex-wrap: wrap; }
.button { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 22px; border-radius: 999px; font-weight: 700; font-size: .93rem; }
.button-primary { background: var(--navy); color: white; }
.button-secondary { border: 1px solid #b7c5d3; background: rgba(255,255,255,.72); }
.availability { font-size: .86rem; color: var(--muted); display: flex; align-items: center; gap: 10px; }
.availability span { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 5px #dcfce7; }
.portrait-card { align-self: stretch; display: flex; flex-direction: column; justify-content: center; }
.portrait-placeholder { min-height: 520px; background: linear-gradient(145deg, #dce8f1, #f7efe0); border-radius: 220px 220px 28px 28px; display: grid; place-content: center; text-align: center; overflow: hidden; position: relative; }
.portrait-placeholder::before { content: ''; width: 290px; height: 420px; border-radius: 150px 150px 34px 34px; background: linear-gradient(180deg, #123458, #476a85); position: absolute; left: 50%; transform: translateX(-50%); bottom: -80px; opacity: .9; }
.portrait-monogram { position: relative; z-index: 1; width: 118px; height: 118px; border-radius: 50%; display: grid; place-items: center; margin: 0 auto 125px; background: var(--white); color: var(--navy); font: 600 2.1rem Georgia, serif; box-shadow: 0 20px 50px rgba(18,52,88,.18); }
.portrait-placeholder p { position: absolute; z-index: 2; bottom: 26px; left: 0; right: 0; color: white; font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; }
.portrait-caption { display: flex; justify-content: space-between; gap: 16px; margin-top: 14px; font-size: .76rem; color: var(--muted); }

.quote-section { min-height: 460px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); display: grid; place-content: center; text-align: center; padding: 70px 20px; }
.quote-section blockquote { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2.2rem, 4.7vw, 5.2rem); line-height: 1.08; letter-spacing: -.04em; max-width: 1100px; color: var(--navy); }
.quote-section p { color: var(--muted); margin-top: 24px; }

.work-section { padding: 140px 0 60px; }
.section-heading { max-width: 760px; margin-bottom: 80px; }
.section-heading h2, .split-section h2, .teaching-section h2, .about-section h2, .contact-section h2 { font-size: clamp(2.5rem, 5vw, 5.2rem); line-height: 1.02; letter-spacing: -.055em; margin: 16px 0 22px; }
.section-heading > p:last-child { color: var(--muted); font-size: 1.08rem; max-width: 620px; }
.projects-list { display: grid; gap: 130px; }
.project-feature { display: grid; grid-template-columns: 1.15fr .85fr; gap: 7vw; align-items: center; }
.project-feature:nth-child(even) .project-visual { order: 2; }
.project-visual { min-height: 520px; border-radius: 26px; position: relative; overflow: hidden; display: grid; place-items: center; }
.visual-forecast { background: #0f172a; }
.visual-dea { background: #e7eef4; }
.visual-anomaly { background: #fff7dc; }
.project-visual svg { width: 88%; height: auto; }
.visual-label { position: absolute; top: 24px; left: 28px; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.7); }
.visual-dea .visual-label, .visual-anomaly .visual-label { color: var(--muted); }
.grid { stroke: rgba(255,255,255,.11); stroke-width: 1; fill: none; }
.line { fill: none; stroke-width: 5; stroke-linecap: round; }
.line.muted { stroke: #6b8294; }
.line.accent { stroke: #eab308; }
.dot { fill: white; stroke: #eab308; stroke-width: 5; }
.axis { stroke: #64748b; stroke-width: 2; fill: none; }
.frontier { stroke: #123458; stroke-width: 5; fill: none; }
.bubble { fill: #eab308; stroke: white; stroke-width: 3; }
.point { fill: #123458; opacity: .38; }
.anomaly { fill: #eab308; stroke: #0f172a; stroke-width: 3; }
.project-copy h3 { font-size: clamp(2rem, 3.6vw, 4rem); line-height: 1.05; letter-spacing: -.045em; margin: 16px 0 24px; }
.project-summary { color: var(--muted); font-size: 1.04rem; }
.metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 30px 0; }
.metrics div { border-top: 1px solid var(--line); padding-top: 14px; }
.metrics strong { display: block; color: var(--navy); font-size: 1.05rem; }
.metrics span { display: block; color: var(--muted); font-size: .72rem; line-height: 1.35; margin-top: 4px; }
.tag-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 28px; }
.tag-list span { border: 1px solid var(--line); border-radius: 999px; padding: 7px 11px; background: rgba(255,255,255,.65); font-size: .75rem; color: #475569; }
.text-link { display: inline-flex; gap: 9px; align-items: center; font-weight: 750; color: var(--navy); border-bottom: 1px solid #9eb2c4; padding-bottom: 4px; }

.split-section { margin: 160px 0; padding: 100px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 1fr 1fr; gap: 8vw; }
.split-section > div:last-child { align-self: end; color: var(--muted); font-size: 1.08rem; }
.split-section .text-link { margin-top: 24px; }
.teaching-section { padding-bottom: 150px; }
.section-heading.compact { margin-bottom: 52px; }
.teaching-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.teaching-grid article { background: white; border: 1px solid var(--line); border-radius: 18px; padding: 30px; min-height: 280px; }
.teaching-grid span { color: var(--gold); font: 700 1.1rem Georgia, serif; }
.teaching-grid h3 { font-size: 1.5rem; line-height: 1.15; letter-spacing: -.03em; margin: 42px 0 18px; }
.teaching-grid p { color: var(--muted); font-size: .94rem; }
.about-section { padding: 130px 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: .55fr 1.45fr; gap: 7vw; }
.about-number { font-family: Georgia, serif; font-size: clamp(5rem, 10vw, 11rem); color: var(--navy); line-height: 1; }
.about-copy { max-width: 780px; }
.about-copy > p:not(.eyebrow) { color: var(--muted); font-size: 1.08rem; }
.contact-section { background: var(--navy); color: white; border-radius: 30px; padding: 80px; margin: 50px 0 34px; }
.contact-section .eyebrow { color: #facc15; }
.contact-section h2 { max-width: 980px; }
.contact-section > p:not(.eyebrow) { color: #cbd5e1; max-width: 650px; }
.contact-links { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 38px; }
.contact-links a { border: 1px solid rgba(255,255,255,.35); padding: 11px 18px; border-radius: 999px; }
footer { display: flex; justify-content: space-between; padding: 30px 0 44px; color: var(--muted); font-size: .82rem; }

[data-reveal] { opacity: 0; transform: translateY(26px); transition: opacity .75s ease, transform .75s ease; }
[data-reveal].is-visible { opacity: 1; transform: translateY(0); }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  [data-reveal] { opacity: 1; transform: none; transition: none; }
}

@media (max-width: 900px) {
  nav a:not(.nav-cta) { display: none; }
  .hero { grid-template-columns: 1fr; padding-top: 50px; }
  .portrait-card { max-width: 560px; }
  .project-feature, .split-section, .about-section { grid-template-columns: 1fr; }
  .project-feature:nth-child(even) .project-visual { order: 0; }
  .teaching-grid { grid-template-columns: 1fr; }
  .contact-section { padding: 48px 28px; }
}

@media (max-width: 560px) {
  .page-shell { width: min(calc(100% - 24px), var(--max)); }
  .site-header { min-height: 74px; }
  .hero { min-height: auto; padding: 54px 0 70px; }
  .hero h1 { font-size: 3.4rem; }
  .portrait-placeholder { min-height: 410px; }
  .quote-section { min-height: 380px; }
  .work-section { padding-top: 100px; }
  .project-visual { min-height: 340px; }
  .metrics { grid-template-columns: 1fr; }
  .split-section { margin: 110px 0; padding: 74px 0; }
  .about-section { padding: 90px 0; }
  .contact-section { border-radius: 20px; }
  footer { flex-direction: column; gap: 8px; }
}
